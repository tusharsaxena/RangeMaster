package-as: RangeMaster

# Libraries are vendored in libs/ and committed to git — NOT fetched as externals.

enable-nolib-creation: no

ignore:
  - .luacheckrc
  - .pkgmeta         # dev-only: this file configures the packager; it is not part of the package
  - .gitignore
  - .gitattributes   # dev-only: the repo's line-ending policy (line-endings)
  - docs             # holds docs/audits/, docs/reviews/ and docs/revendor/ too — all dev-only
  - tests
  - _dev
  - "*.bak"
  # Developer documentation. README.md and LICENSE stay, because players read those.
  - CLAUDE.md
  - DEPENDENCIES.md
  # Only the .tga logos are loadable at runtime; WoW cannot read .png or .jpg at all. The master .png
  # and the .jpg render exist for the project page and for regenerating the .tga files.
  - media/logos/*.png
  - media/logos/*.jpg
