## Interface: 120105, 16001
## Title: Ka0s Range Master
## Notes: Build your own range displays for target, focus, pet, mouseover and nameplates.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\RangeMaster\media\logos\rangemaster.logo.128.tga
## SavedVariables: RangeMasterDB, RangeMasterPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, LibRangeCheck-3.0, EllesmereUI
## DefaultState: enabled
## Category-enUS: Combat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (vendored in libs/ — load first)
#@no-lib-strip@
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml
# The range estimator (WeakAuras/LibRangeCheck-3.0, MINOR 39); DEPENDENCIES.md records its commit.
libs\LibRangeCheck-3.0\LibRangeCheck-3.0.lua
libs\LibSharedMedia-3.0\lib.xml
#@end-no-lib-strip@

# Locales
# LOAD-BEARING: bootstraps NS.L, which every file below reads at load (core/CoreSetup.lua's
# NS.LIBKA0S_MISSING first).
locales\enUS.lua

# Core — dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.name, NS.version and NS.PREFIX, which every seam below reads.
core\Namespace.lua
# Conventional: the client seam and the secret guards, reached at call time.
core\Compat.lua
# Conventional: the LibKa0s-Env seam; nothing is resolved at load.
core\EnvSetup.lua
# LOAD-BEARING: before Constants, deliberately. Constants.FONT_MONO is resolved from the
# NS.MediaFont seam this file publishes, so a Constants that loaded first would take the fallback.
core\MediaSetup.lua
core\Constants.lua
# Conventional: session-only state (the debug flag, Test mode, Sim mode, rejected events).
core\State.lua
# LOAD-BEARING: after Namespace (NS.PREFIX) and before everything that prints; publishes
# NS.LIBKA0S_MISSING, which every later degradation stub reads.
core\CoreSetup.lua
# LOAD-BEARING: the LibKa0s-Skin-1.0 seam. Registers the skin owner at FILE LOAD (skinning-§1) and
# publishes NS.DEFAULT_SKIN, read at load by defaults\Profile.lua, and NS.SKIN_OPTIONS, read at load
# by settings\General.lua. After CoreSetup, whose NS.Print the reload line uses.
core\SkinSetup.lua
# LOAD-BEARING: publishes NS.bus, NS.MSG and NS.NewBusTarget, and the stand-down record
# core\LifecycleSetup.lua drives.
core\Bus.lua
# LOAD-BEARING: before core\PerfSetup.lua, which takes NS.lifecycle as its `lifecycle` descriptor
# field; LibKa0s-Perf-1.0 raises at New without one.
core\LifecycleSetup.lua
# LOAD-BEARING: publishes NS.Perf, a file-scope upvalue in core\RangeMaster.lua (performance-§1).
core\PerfSetup.lua
# Conventional: the LibKa0s-Pool-1.0 seam (the library's pool, or a local copy of its contract);
# reached by modules\Container.lua and modules\Elements_Spells.lua at load, both later.
core\PoolSetup.lua
# Conventional: the settings read seam and the minimap row's storage, reached at call time.
core\Data.lua
# Conventional: reached from OnInitialize, at call time.
core\Database.lua
# LOAD-BEARING: after Constants (the font), State (the flag) and CoreSetup (the printer), and before
# anything that calls NS.Debug.
core\DebugLogSetup.lua
# Conventional: the LibKa0s-Launcher-1.0 seam. Reads Constants at load; NS.db, the modes and the
# settings panel are all reached at Register or click time.
core\LauncherSetup.lua
# LOAD-BEARING: the AceAddon promotion; reclaims NS.Print and NS.Printf from AceConsole's embed, which
# settings\Slash.lua captures at load.
core\RangeMaster.lua

# Defaults
# Conventional: the profile defaults; reads NS.DEFAULT_SKIN (core\SkinSetup.lua) at load.
defaults\Profile.lua
# Conventional: the per-client, per-class spell seeds; data only, read at call time by
# core\Compat.lua's RangeLadder.
defaults\SpellSeeds.lua
# Conventional: the preset band sets; data only, after defaults\Profile.lua and core\Compat.lua, whose
# ClientKey picks the hunter set at load (clients-§5).
defaults\BandSetPresets.lua

# Modules
# Conventional: the band-set registry's writer, Resolve and ForUnit; the db, the presets and the bus
# are reached at call time (the load pass calls Seed and NormalizeSet from OnInitialize).
modules\BandSets.lua
# LOAD-BEARING: before modules\Ticker.lua, whose tick reads NS.Range; captures NS.Perf and
# LibRangeCheck-3.0 at load.
modules\Range.lua
# Conventional: the one range ticker; NS.Range and the bus are reached at call time.
modules\Ticker.lua
# Conventional: the container registry's one writer and the coalesced, combat-deferred apply; the db,
# the band sets, the spell seeds and the bus are reached at call time.
modules\ContainerManager.lua
# Conventional: the three container presets; NS.CM and NS.BandSets are reached at call time.
modules\Presets.lua
# LOAD-BEARING: the renderer's drawing helpers, captured at load by the four element files and
# modules\Container.lua below.
modules\Style.lua
# LOAD-BEARING: the four elements, each publishing NS.Elements.<Name>, which modules\Container.lua
# captures at load; Elements_Spells captures NS.Pool (core\PoolSetup.lua) at load.
modules\Elements_Number.lua
modules\Elements_Text.lua
modules\Elements_Indicator.lua
modules\Elements_Spells.lua
# Conventional: the renderer; subscribes at load (NS.NewBusTarget, core\Bus.lua) and reaches NS.CM,
# NS.BandSets, NS.Range and NS.Ticker at call time.
modules\Container.lua
# LOAD-BEARING: the anchor dispatcher, before every modules\Anchors_*.lua file, each of which registers
# its mode on NS.Anchors at load. modules\Container.lua reaches it at call time.
modules\Anchors.lua
# Conventional: the unit-frame providers' names; reached by modules\Anchors_Frame.lua at call time.
modules\FrameProviders.lua
# Conventional: the four anchor modes, each registering on NS.Anchors at load; the registry, the
# providers and the plates are reached at call time.
modules\Anchors_Screen.lua
modules\Anchors_Frame.lua
modules\Anchors_Nameplate.lua
modules\Anchors_Cursor.lua
# Conventional: the click-to-pick overlay, built on first use; captures NS.Style (modules\Style.lua).
modules\FramePicker.lua
# Conventional: the behavior rules, reached by modules\Container.lua at call time: visibility, and the
# band sounds (registers its built-in sound keys with LibSharedMedia at load; reads NS.Presets).
modules\Visibility.lua
modules\Sounds.lua
# Conventional: the two preview modes, each subscribing to MODE_CHANGED at load. modules\Sim.lua builds
# its LibKa0s-Sim-1.0 seam and session at load; modules\Preview.lua owns the fake range source.
modules\Sim.lua
modules\Preview.lua
# Conventional: the diagnostics report's sections (debug-logging-§14); the DebugLog descriptor asks
# for them when a report runs.
modules\Diagnostics.lua

# Settings (last — depend on everything else being initialized)
# LOAD-BEARING: publishes NS.SchemaRuntime (read at load by settings\Slash.lua and settings\OptionsSetup.lua) and NS.RegisterSchemaRows (called at load by settings\General.lua).
settings\Schema.lua
# LOAD-BEARING: publishes NS.COMMANDS and NS.Slash before settings\OptionsSetup.lua.
settings\Slash.lua
# LOAD-BEARING: publishes NS.Helpers, captured at load by settings\About.lua and settings\General.lua, and NS.RegisterOptionsPage, called at load by every page file below.
settings\OptionsSetup.lua
# LOAD-BEARING: captures NS.Helpers at load and defines Helpers.BuildMainContent on it, so it must follow settings\OptionsSetup.lua; the spec itself is read at render time.
settings\About.lua
# LOAD-BEARING: the first registered page after the landing page, so General leads the sidebar.
settings\General.lua
# LOAD-BEARING: publishes NS.RegisterContainerSection, NS.ContainerValues and NS.RequestPanelRefresh, which
# every settings\Containers_*.lua file below calls or reads at load; the Containers page, second in the sidebar.
settings\Containers.lua
# Conventional: the Containers page's other rail entries, in rail order (each registers at load).
settings\Containers_Display.lua
settings\Containers_Indicator.lua
settings\Containers_Visibility.lua
settings\Containers_Sounds.lua
# Conventional: the Band sets page, third in the sidebar; reads NS.RequestPanelRefresh and NS.BandRibbon
# (settings\Containers.lua) at call time.
settings\BandSets.lua
# Conventional: the General page's Presets tab and the first-run picker; settings\General.lua reads
# NS.PRESETS_TAB at render time.
settings\Presets.lua
# Conventional: last only by habit; nothing reads what it registers until the panel opens.
settings\Profiles.lua
